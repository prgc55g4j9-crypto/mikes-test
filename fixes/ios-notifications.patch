--- a/ios/App/App/SceneDelegate.swift
+++ b/ios/App/App/SceneDelegate.swift
@@ -9,6 +9,7 @@ class SceneDelegate: UIResponder, UIWindowSceneDelegate {
     func scene(_ scene: UIScene, willConnectTo session: UISceneSession, options connectionOptions: UIScene.ConnectionOptions) {
         guard let windowScene = scene as? UIWindowScene else { return }
 
+        if connectionOptions.notificationResponse != nil { MikesPushController.openPending = true }
         window = UIWindow(windowScene: windowScene)
         window?.rootViewController = MikesPushController()
         window?.makeKeyAndVisible()
@@ -16,6 +17,14 @@ class SceneDelegate: UIResponder, UIWindowSceneDelegate {
         SceneDelegateProxy.shared.scene(scene, willConnectTo: session, options: connectionOptions)
     }
 
+    func sceneDidBecomeActive(_ scene: UIScene) {
+        AppDelegate.refreshRemoteNotificationRegistration()
+        guard let controller = window?.rootViewController as? MikesPushController else { return }
+        controller.emit("mikes-app-active", detail: [:])
+        controller.emitToken()
+        controller.syncBadge()
+    }
+
     func scene(_ scene: UIScene, openURLContexts URLContexts: Set<UIOpenURLContext>) {
         SceneDelegateProxy.shared.scene(scene, openURLContexts: URLContexts)
     }
